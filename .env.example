# Copy to .env and adjust. Every service reads the same file.

# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://linkpulse:linkpulse@localhost:5432/linkpulse

# Redis: link cache, click counters, click stream, rate limits
REDIS_URL=redis://127.0.0.1:6379

# Public URL the short links live under (no trailing slash)
PUBLIC_BASE_URL=http://localhost:8440/lk
# Path prefix of that URL, used for cookies and the dashboard
BASE_PATH=/lk

# Secret used to sign session cookies and unlock cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Ports
API_PORT=8441
REDIRECT_PORT=8442
GATEWAY_PORT=8440

# Calendar days for rollups and charts (IANA name)
APP_TIMEZONE=Asia/Kolkata

# Optional: Google Safe Browsing v4 key. Without it, only the blocklist is checked.
SAFE_BROWSING_KEY=

# Admin account created by the seed script
ADMIN_EMAIL=admin@linkpulse.local
ADMIN_PASSWORD=change-me
