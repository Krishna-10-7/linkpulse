{
  "manifest_version": 3,
  "name": "LinkPulse — shorten from anywhere",
  "short_name": "LinkPulse",
  "version": "0.1.0",
  "description": "Right-click any link or page to create a LinkPulse short link, copied to your clipboard with a QR code.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Shorten with LinkPulse", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "options_page": "options.html",
  "permissions": ["contextMenus", "storage", "notifications", "offscreen", "activeTab"],
  "host_permissions": ["https://r2-d2.xyz/*", "http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "commands": {
    "shorten-current-tab": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Shorten the current tab and copy the link"
    }
  },
  "omnibox": { "keyword": "lp" }
}
