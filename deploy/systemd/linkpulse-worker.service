[Unit]
Description=LinkPulse click worker and link health monitor
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=linkpulse
WorkingDirectory=/opt/linkpulse/current/apps/worker
EnvironmentFile=/etc/linkpulse/linkpulse.env
ExecStart=/usr/bin/node src/worker.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
