[Unit]
Description=LinkPulse redirect service
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=linkpulse
WorkingDirectory=/opt/linkpulse/current/apps/redirect
EnvironmentFile=/etc/linkpulse/linkpulse.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
